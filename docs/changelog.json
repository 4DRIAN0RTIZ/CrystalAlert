ntents unchanged\n- website/index.html: local <link>/<script> point to ../src/ (the\n  jsdelivr CDN URLs are untouched)\n- tests/smoke.test.js: load the source from ../src/\n- .npmignore: keep website/, progress/, docs/ out of the package","footers":[],"group":"Refactor","breaking_description":null,"breaking":false,"scope":null,"links":[],"author":{"name":"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1788733286},"committer":{"name":"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1788733804},"conventional":true,"merge_commit":false,"statistics":{"files_changed":13,"additions":2951,"deletions":2951},"extra":null,"github":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitlab":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitea":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"bitbucket":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"azure_devops":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"raw_message":"refactor: move library source under src/\n\nSeparate the library source from packaging, website and meta files.\nNo behavior change; the published bundle is byte-identical.\n\n- src/: crystal-alert.js, crystal-alert-styles.css, themes/ (moved\n  with rename detection, history preserved)\n- package.json: build scripts read inputs from src/; `files` whitelist\n  is now [\"dist/\", \"src/\"]; dist/ output names and contents unchanged\n- website/index.html: local <link>/<script> point to ../src/ (the\n  jsdelivr CDN URLs are untouched)\n- tests/smoke.test.js: load the source from ../src/\n- .npmignore: keep website/, progress/, docs/ out of the package"},{"id":"fac6c614a98541189bc27ae0ccd86cfe92f6f509","message":"bootstrap Vitest smoke suite","body":"Add a lightweight test runner so features can close on green tests.\n\n- package.json: `test` script (`vitest run`); devDeps vitest, jsdom\n- vitest.config.js: jsdom environment, tests/**/*.test.js\n- tests/smoke.test.js: loads crystal-alert.js and asserts the public\n  API (Crystal singleton, fire(), toast()) without touching the source\n- pnpm-workspace.yaml: pin the repo as its own workspace root so local\n  installs keep the lockfile in sync\n- .npmrc: local trust-policy override so a clean install resolves","footers":[],"group":"Testing","breaking_description":null,"breaking":false,"scope":null,"links":[],"author":{"name":"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1788733252},"committer":{"name":"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1788733777},"conventional":true,"merge_commit":false,"statistics":{"files_changed":6,"additions":1393,"deletions":3},"extra":null,"github":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitlab":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitea":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"bitbucket":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"azure_devops":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"raw_message":"test: bootstrap Vitest smoke suite\n\nAdd a lightweight test runner so features can close on green tests.\n\n- package.json: `test` script (`vitest run`); devDeps vitest, jsdom\n- vitest.config.js: jsdom environment, tests/**/*.test.js\n- tests/smoke.test.js: loads crystal-alert.js and asserts the public\n  API (Crystal singleton, fire(), toast()) without touching the source\n- pnpm-workspace.yaml: pin the repo as its own workspace root so local\n  installs keep the lockfile in sync\n- .npmrc: local trust-policy override so a clean install resolves"},{"id":"56367ba7cef75c3f21250ca0e0d231abe2fab97e","message":"add public roadmap issue template","body":"Adopts the issue-driven roadmap convention shared across repos: a `roadmap`\nlabel plus `roadmap:working|planned|idea` status labels (closed = done),\nconsumed live by the portfolio's \"what I'm doing\" widget.","footers":[],"group":"Features","breaking_description":null,"breaking":false,"scope":"roadmap","links":[],"author":{"name":"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1788581226},"committer":{"name":"Neandertech","email":"2121100617@soy.utj.edu.mx","timestamp":1788581226},"conventional":true,"merge_commit":false,"statistics":{"files_changed":1,"additions":27,"deletions":0},"extra":null,"github":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitlab":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitea":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"bitbucket":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"azure_devops":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"raw_message":"feat(roadmap): add public roadmap issue template\n\nAdopts the issue-driven roadmap convention shared across repos: a `roadmap`\nlabel plus `roadmap:working|planned|idea` status labels (closed = done),\nconsumed live by the portfolio's \"what I'm doing\" widget."},{"id":"6f1cef62e5a688848407304e88f338bb90feff8e","message":"redesign landing page experience","body":"- refresh